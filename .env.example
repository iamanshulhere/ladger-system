# Backend Ledger environment variable reference.
# Spring Boot does not load this file directly. Keep real values in process or deployment configuration.

# Use a replica set for multi-document transaction endpoints.
MONGO_URI=mongodb://localhost:27017/backend-ledger?replicaSet=rs0

# Required; use a randomly generated value containing at least 32 UTF-8 bytes.
JWT_SECRET=

# Lifetime in days; accepted range is 1 through 3.
JWT_EXPIRATION_DAYS=3

# Set false only for local HTTP development. Use true behind HTTPS.
AUTH_COOKIE_SECURE=true

# HTTP port.
SERVER_PORT=3000